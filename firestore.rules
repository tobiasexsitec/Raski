rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

	function isSignedIn() {
	  return request.auth != null;
	}

	function hasAccount() {
	  return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
	}

	function myEmail() {
	  return request.auth.token.email.lower();
	}

	function tripData(tripId) {
	  return get(/databases/$(database)/documents/trips/$(tripId)).data;
	}

	function isTripMember(tripId) {
	  return isSignedIn() && request.auth.uid in tripData(tripId).memberUids;
	}

	function isTripOwner(tripId) {
	  return isSignedIn() && request.auth.uid == tripData(tripId).ownerUid;
	}

	// The trip owner, or a global admin who is a member, manages participants.
	function canManageMembers(tripId) {
	  return isTripOwner(tripId) || (isTripMember(tripId) && isGlobalAdmin());
	}

	// Policies (B-056) are managed by those who manage members, or by a member
	// who has been granted the permission on their member document.
	function canManagePolicies(tripId) {
	  return canManageMembers(tripId)
			 || (isTripMember(tripId)
				 && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('canManagePolicies', false) == true);
	}

	function isPendingEmail(data) {
	  return isSignedIn() && myEmail() in data.get('pendingEmails', []);
	}

	function keepsPendingEmails() {
	  return request.resource.data.get('pendingEmails', [])
			 == resource.data.get('pendingEmails', []);
	}

	// A participant added by email joins by adding only their own uid.
	function joinsFromPendingEmail() {
	  return isPendingEmail(resource.data)
			 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
			 && request.resource.data.memberUids.toSet()
				== resource.data.memberUids.toSet().union([request.auth.uid].toSet());
	}

	// After joining, the participant removes only their own pending email.
	function removesOwnPendingEmail() {
	  return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingEmails'])
			 && request.resource.data.get('pendingEmails', []).toSet()
				== resource.data.get('pendingEmails', []).toSet().difference([myEmail()].toSet());
	}

	function pollData(tripId, pollId) {
	  return get(/databases/$(database)/documents/trips/$(tripId)/polls/$(pollId)).data;
	}

	function isPollCreator(tripId, pollId) {
	  return isTripMember(tripId) && request.auth.uid == pollData(tripId, pollId).createdByUid;
	}

	// The flag lives on the user's own profile document and can only be granted
	// by another global admin. The first admin is set manually in the console.
	function isGlobalAdmin() {
	  return isSignedIn()
			 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isGlobalAdmin == true;
	}

	function keepsAdminFlag() {
	  return request.resource.data.get('isGlobalAdmin', false)
			 == resource.data.get('isGlobalAdmin', false);
	}

	function keepsAllergies() {
	  return request.resource.data.get('allergies', [])
			 == resource.data.get('allergies', []);
	}

	function keepsPhone() {
	  return request.resource.data.get('phone', '')
			 == resource.data.get('phone', '');
	}

	// Users own their profile document. Other signed-in users may read it so
	// participant lists can show names and avatars.
	match /users/{uid} {
	  allow read: if isSignedIn();

	  allow create: if isSignedIn()
					&& request.auth.uid == uid
					&& request.resource.data.get('isGlobalAdmin', false) == false;

	  // A user maintains their own profile but cannot promote themselves;
	  // only a global admin may change the isGlobalAdmin flag.
	  // Allergies and phone may only be changed by the user themselves.
	  allow update: if isSignedIn()
					&& ((request.auth.uid == uid && keepsAdminFlag())
						|| (isGlobalAdmin() && keepsAllergies() && keepsPhone()));

	  allow delete: if false;
	}

	// Households group partners and their children. Any signed-in user may read
	// them so trip participant lists can show children; only members may write.
	// Linking a partner applies directly, without approval (B-047).
	match /households/{householdId} {
	  allow read: if isSignedIn();

	  allow create: if isSignedIn()
					&& request.auth.uid in request.resource.data.memberUids;

	  allow update: if isSignedIn()
					&& request.auth.uid in resource.data.memberUids;

	  allow delete: if isSignedIn()
					&& resource.data.memberUids == [request.auth.uid];
	}

	// Any user with an account may create a trip and becomes its owner. Trips are
	// readable and writable by their members; only the owner may change
	// membership or delete the trip.
	match /trips/{tripId} {
	  allow read: if isSignedIn()
				  && (request.auth.uid in resource.data.memberUids || isPendingEmail(resource.data));

	  allow create: if hasAccount()
					&& request.resource.data.ownerUid == request.auth.uid
					&& request.auth.uid in request.resource.data.memberUids;

	  allow update: if (isTripMember(tripId)
						&& (canManageMembers(tripId)
							|| (request.resource.data.memberUids == resource.data.memberUids
								&& (keepsPendingEmails() || removesOwnPendingEmail()))))
					|| joinsFromPendingEmail();

	  allow delete: if isTripOwner(tripId);

	  // Denormalized participant info.
	  match /members/{memberUid} {
		allow read: if isTripMember(tripId);
		allow write: if canManageMembers(tripId);

		// A participant added by email takes over their membership on sign-in.
		allow create: if isTripMember(tripId)
					  && request.auth.uid == memberUid
					  && isPendingEmail(tripData(tripId))
					  && request.resource.data.role == 'member';
		allow delete: if isTripMember(tripId) && memberUid == 'pending-' + myEmail();

		// Members may override their own alcohol preference for this trip.
		allow update: if isTripMember(tripId)
					  && request.auth.uid == memberUid
					  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alcohol']);
	  }

	  // Children who do not join this trip; all others join by default.
	  match /excludedChildren/{childId} {
		allow read, write: if isTripMember(tripId);
	  }

	  // Meals are collaborative: any member may plan, edit and remove them.
	  match /meals/{mealId} {
		allow read, write: if isTripMember(tripId);
	  }

	  // The shared breakfast for the whole trip, edited by any member.
	  match /breakfast/{breakfastId} {
		allow read, write: if isTripMember(tripId);
	  }

	  // The shared drinks for the whole trip, edited by any member.
	  match /drinks/{drinksId} {
		allow read, write: if isTripMember(tripId);
	  }

	  // Shared "who brings what" list, edited by any member.
	  match /bringItems/{itemId} {
		allow read, write: if isTripMember(tripId);
	  }

	  // Custom "who brings what" sections, managed by any member.
	  match /bringSections/{sectionId} {
		allow read, write: if isTripMember(tripId);
	  }

	  // Polls: any member may create one; only its creator may edit or
	  // delete it. Only a global admin may close or reopen it.
	  match /polls/{pollId} {
		allow read: if isTripMember(tripId);
		allow create: if isTripMember(tripId)
						&& request.resource.data.createdByUid == request.auth.uid
						&& request.resource.data.get('closed', false) == false;
		allow update: if (isPollCreator(tripId, pollId) || isGlobalAdmin())
						&& request.resource.data.createdByUid == resource.data.createdByUid
						&& (isGlobalAdmin()
							|| request.resource.data.get('closed', false) == resource.data.get('closed', false));
		allow delete: if isPollCreator(tripId, pollId);

		// Options can never be removed by voters; the creator may add and
		// edit them, other members may add when the poll allows it.
		match /options/{optionId} {
		  allow read: if isTripMember(tripId);
		  allow create: if isPollCreator(tripId, pollId)
						  || (isTripMember(tripId)
							  && pollData(tripId, pollId).allowCustomOptions == true
							  && pollData(tripId, pollId).closed != true);
		  allow update, delete: if isPollCreator(tripId, pollId);
		}

		// One vote document per member, keyed by uid.
		match /votes/{voterUid} {
		  allow read: if isTripMember(tripId);
		  allow create, update: if isTripMember(tripId)
								  && request.auth.uid == voterUid
								  && pollData(tripId, pollId).closed != true;
		  allow delete: if (isTripMember(tripId) && request.auth.uid == voterUid)
						  || isPollCreator(tripId, pollId);
		}
	  }

	  // Trip policies (B-056): read by all members, managed by the owner or
	  // a global admin. A member may only add their own acceptance.
	  match /policies/{policyId} {
		allow read: if isTripMember(tripId);
		allow create, delete: if canManagePolicies(tripId);
		allow update: if canManagePolicies(tripId)
						|| (isTripMember(tripId)
							&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy'])
							&& request.resource.data.get('acceptedBy', {})
								 .diff(resource.data.get('acceptedBy', {}))
								 .affectedKeys().hasOnly([request.auth.uid]));
	  }

	  // Shared check-off state for the shopping list.
	  match /shoppingState/{ingredientId} {
		allow read, write: if isTripMember(tripId);
	  }

	  // Items added directly to the shopping list, edited by any member.
	  match /shoppingExtras/{extraId} {
		allow read, write: if isTripMember(tripId);
	  }
	}

	// The global ingredient and unit registries are shared by all trips.
	// Any signed-in user may create and edit ingredients, but only global
	// admins may merge (change mergedIntoId) or delete them.
	function keepsMergedIntoId() {
	  return request.resource.data.get('mergedIntoId', '')
			 == resource.data.get('mergedIntoId', '');
	}

	match /ingredients/{ingredientId} {
	  allow read: if isSignedIn();
	  allow create: if isSignedIn()
					&& (request.resource.data.get('mergedIntoId', '') == ''
						|| isGlobalAdmin());
	  allow update: if isSignedIn() && (keepsMergedIntoId() || isGlobalAdmin());
	  allow delete: if isGlobalAdmin();
	}

	match /units/{unitId} {
	  allow read, create, update: if isSignedIn();
	  allow delete: if false;
	}

	// Shared suggestion list for allergies and dietary preferences.
	match /allergies/{allergyId} {
	  allow read, create, update: if isSignedIn();
	  allow delete: if false;
	}

	// Feature requests can be submitted by any signed-in user in their own
	// name but are only readable by global admins.
	match /featureRequests/{requestId} {
	  allow read: if isGlobalAdmin();
	  allow create: if isSignedIn()
					&& request.resource.data.createdByUid == request.auth.uid
					&& request.resource.data.title is string
					&& request.resource.data.title.size() > 0
					&& request.resource.data.title.size() <= 200
					&& request.resource.data.description is string
					&& request.resource.data.description.size() <= 5000;
	  allow update: if false;
	  allow delete: if isGlobalAdmin();
	}

	match /tags/{tagId} {
	  allow read, create, update: if isSignedIn();
	  allow delete: if false;
	}

	// Invitations are keyed by the lowercased email address. A trip owner can
	// write one, and only the invited user can read and consume it, because
	// Firestore cannot resolve an email to a uid at rule evaluation time.
	match /invites/{email}/trips/{tripId} {
	  allow read, delete: if isSignedIn() && myEmail() == email;
	  allow create, update: if isTripOwner(tripId);
	}
  }
}
