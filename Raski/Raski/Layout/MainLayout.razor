@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AppEnvironmentOptions Environment

<div class="shell">
    <a class="skip-link" href="#main">Hoppa till innehållet</a>

    <header class="app-bar">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">🕶️</span>
            <span class="brand-name">Raski™</span>
        </a>

        @if (!Environment.IsProduction)
        {
            <span class="tag tag-accent env-tag" role="status" title="Du använder testmiljön – data här påverkar inte produktion">@Environment.Name</span>
        }

        <div class="spacer"></div>

        @if (AuthService.Current is { } user)
        {
            <div class="user-menu">
                <button type="button"
                        class="avatar-btn"
                        aria-haspopup="true"
                        aria-expanded="@menuOpen"
                        title="@user.DisplayName"
                        @onclick="ToggleMenu">
                    @if (!string.IsNullOrEmpty(user.PhotoUrl))
                    {
                        <img src="@user.PhotoUrl" alt="" />
                    }
                    else
                    {
                        <span class="avatar-fallback" aria-hidden="true">@Initial(user.DisplayName)</span>
                    }
                </button>

                @if (menuOpen)
                {
                    <div class="menu-popover" @onkeydown="OnMenuKeyDown">
                        <div class="menu-user">
                            <strong>@user.DisplayName</strong>
                            <span class="muted">@user.Email</span>
                        </div>
                        <button type="button" class="menu-item" @onclick="SignOutAsync">Logga ut</button>
                    </div>
                }
            </div>
        }
    </header>

    @if (menuOpen)
    {
        <div class="menu-backdrop" aria-hidden="true" @onclick="CloseMenu"></div>
    }

    <main class="content" id="main" tabindex="-1">
        <AuthGuard AllowAnonymous="IsPublicPage()">
            <div @key="refreshKey">
                @Body
            </div>
        </AuthGuard>
    </main>

    <PullToRefresh OnRefresh="Refresh" />

    <footer class="app-footer">
        <a class="about-link" href="about"><span class="info-icon" aria-hidden="true">i</span> Om Raski™</a>
        <span aria-hidden="true">·</span>
        <span class="app-version" title="Appversion">v@(AppVersion)</span>
    </footer>

    <NavMenu />

    @if (AuthService.Current is { NeedsOnboarding: false })
    {
        <WhatsNewDialog />
    }
</div>

@code {
    private static readonly string AppVersion = AppInfo.InformationalVersion;

    private bool menuOpen;
    private int refreshKey;

    // A new key recreates the page component so it reloads its data without restarting the app.
    private void Refresh()
    {
        menuOpen = false;
        refreshKey++;
    }

    protected override void OnInitialized()
    {
        AuthService.StateChanged += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private bool IsPublicPage() =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Equals("about", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private void OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            menuOpen = false;
        }
    }

    private async Task SignOutAsync()
    {
        menuOpen = false;
        await AuthService.SignOutAsync();
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private void OnStateChanged() => StateHasChanged();

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        menuOpen = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthService.StateChanged -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
