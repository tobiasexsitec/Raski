@page "/about"
@inject IReleaseNotesService ReleaseNotesService
@inject IFeatureRequestService FeatureRequestService
@inject IAuthService AuthService

<PageTitle>Om Raski™</PageTitle>

<div class="stack">
    <header class="page-header">
        <h1>Om Raski™</h1>
    </header>

    <section class="card stack" aria-labelledby="about-description">
        <h2 id="about-description">Vad är Raski™?</h2>
        @foreach (var section in AboutContent.Sections)
        {
            <p>@section.Text</p>
        }
        <p class="muted">Version <strong>@AppVersion</strong></p>
    </section>

    <section class="card stack" aria-labelledby="about-release-notes">
        <h2 id="about-release-notes">Release notes</h2>
        @if (releases is null)
        {
            <p class="muted" role="status">Laddar…</p>
        }
        else if (errorMessage is not null)
        {
            <div class="error-banner" role="alert">@errorMessage</div>
        }
        else
        {
            <ul class="release-list">
                @foreach (var release in releases)
                {
                    <li class="release">
                        <h3 class="release-version">
                            <span class="tag tag-accent">@release.Version</span>
                            @if (release.Date is { } date)
                            {
                                <time class="release-date muted" datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("yyyy-MM-dd")</time>
                            }
                        </h3>
                        <ul>
                            @foreach (var note in release.Notes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card stack" aria-labelledby="about-contact">
        <h2 id="about-contact">Kontakt</h2>
        <p>
            Raski™ utvecklas av @ContactName. Har du frågor, hittat en bugg eller har ett
            förslag? Hör av dig till <a href="mailto:@ContactEmail">@ContactEmail</a>.
        </p>

        @if (AuthService.Current is not null)
        {
            <h3 id="about-feature-request">Önska en funktion</h3>
            @if (requestErrorMessage is not null)
            {
                <div class="error-banner" role="alert">@requestErrorMessage</div>
            }
            @if (requestSent)
            {
                <p role="status">Tack! Ditt önskemål har skickats.</p>
            }
            <div class="field">
                <label class="field-label" for="feature-title">Titel</label>
                <input id="feature-title" maxlength="200" @bind="requestTitle" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field-label" for="feature-description">Beskrivning</label>
                <textarea id="feature-description" rows="4" maxlength="5000" @bind="requestDescription" @bind:event="oninput"></textarea>
            </div>
            <div class="row-inline">
                <button type="button" class="btn btn-primary" disabled="@isSending" @onclick="SubmitRequestAsync">
                    @(isSending ? "Skickar…" : "Skicka önskemål")
                </button>
                @if (AuthService.IsGlobalAdmin)
                {
                    <a class="btn btn-secondary" href="admin/onskemal">Visa alla önskemål</a>
                }
            </div>
        }
    </section>
</div>

@code {
    private const string ContactName = "Tobias Krispinsson";
    private const string ContactEmail = "tobias.krispinsson@gmail.com";

    private static readonly string AppVersion =
        (typeof(About).Assembly
            .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
            .OfType<System.Reflection.AssemblyInformationalVersionAttribute>()
            .FirstOrDefault()?.InformationalVersion
        ?? typeof(About).Assembly.GetName().Version?.ToString()
        ?? "?").Split('+')[0];

    private IReadOnlyList<ReleaseNote>? releases;
    private string? errorMessage;

    private string requestTitle = "";
    private string requestDescription = "";
    private bool isSending;
    private bool requestSent;
    private string? requestErrorMessage;

    private async Task SubmitRequestAsync()
    {
        requestErrorMessage = null;
        requestSent = false;

        if (string.IsNullOrWhiteSpace(requestTitle))
        {
            requestErrorMessage = "Ange en titel.";
            return;
        }

        isSending = true;
        try
        {
            await FeatureRequestService.SubmitAsync(requestTitle, requestDescription);
            requestTitle = "";
            requestDescription = "";
            requestSent = true;
        }
        catch (Exception ex)
        {
            requestErrorMessage = $"Kunde inte skicka önskemålet. {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            releases = await ReleaseNotesService.GetAsync();
        }
        catch (Exception)
        {
            releases = [];
            errorMessage = "Kunde inte ladda release notes.";
        }
    }
}
