@page "/resor/{TripId}"
@page "/resor/{TripId}/maltider"
@page "/resor/{TripId}/vem-tar-med"
@inject ITripService TripService
@inject NavigationManager Navigation

<PageTitle>@(trip?.Name ?? "Resa") – Raski</PageTitle>

@if (isLoading)
{
    <p class="muted">Hämtar resan…</p>
}
else if (errorMessage is not null)
{
    <div class="error-banner">@errorMessage</div>
}
else if (trip is not null)
{
    <div class="page-header">
        <div>
            <h1>@trip.Name</h1>
            <p class="muted">
                @if (!string.IsNullOrWhiteSpace(trip.Destination))
                {
                    <span>📍 @trip.Destination · </span>
                }
                <span>@trip.StartDate.ToString("yyyy-MM-dd") – @trip.EndDate.ToString("yyyy-MM-dd")</span>
            </p>
        </div>

        <div class="row-inline">
            <a class="btn btn-secondary" href="@($"resor/{TripId}/inkopslista")">Inköpslista</a>
            @if (IsAdmin)
            {
                <a class="btn btn-secondary" href="@($"resor/{TripId}/redigera")">Redigera</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(trip.Notes))
    {
        <section class="card notes">
            <h2>Övrig info</h2>
            <p>@trip.Notes</p>
        </section>
    }

    <nav class="trip-tabs" role="tablist" aria-label="Resans flikar">
        <a class="trip-tab @(IsBringTab ? "" : "active")"
           role="tab"
           id="tab-meals"
           aria-selected="@(!IsBringTab ? "true" : "false")"
           aria-controls="tabpanel"
           href="@($"resor/{TripId}/maltider")">Måltider</a>
        <a class="trip-tab @(IsBringTab ? "active" : "")"
           role="tab"
           id="tab-bring"
           aria-selected="@(IsBringTab ? "true" : "false")"
           aria-controls="tabpanel"
           href="@($"resor/{TripId}/vem-tar-med")">Vem tar med</a>
    </nav>

    <div id="tabpanel" role="tabpanel" aria-labelledby="@(IsBringTab ? "tab-bring" : "tab-meals")">
        @if (IsBringTab)
        {
            <BringList Trip="trip" />
        }
        else
        {
            <BreakfastPanel Trip="trip" />

            <MealList Trip="trip" />

            <MembersPanel TripId="@TripId" IsAdmin="IsAdmin" />
        }
    </div>
}

@code {
    [Parameter] public string TripId { get; set; } = "";

    [CascadingParameter(Name = "CurrentUser")]
    private UserProfile? CurrentUser { get; set; }

    private Trip? trip;
    private bool isLoading = true;
    private string? errorMessage;

    private bool IsAdmin => trip?.IsOwner(CurrentUser?.Uid) == true;

    private bool IsBringTab =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]
            .EndsWith("/vem-tar-med", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        // Switching tabs re-renders the same page; only reload when the trip changes.
        if (trip is not null && trip.Id == TripId)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            trip = await TripService.GetAsync(TripId);

            if (trip is null)
            {
                errorMessage = "Resan hittades inte.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte hämta resan.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
