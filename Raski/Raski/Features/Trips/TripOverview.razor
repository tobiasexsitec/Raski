@page "/resor/{TripId}"
@page "/resor/{TripId}/oversikt"
@page "/resor/{TripId}/maltider"
@page "/resor/{TripId}/vem-tar-med"
@page "/resor/{TripId}/omrostningar"
@inject ITripService TripService
@inject ITripPolicyService PolicyService
@inject NavigationManager Navigation

<PageTitle>@(trip?.Name ?? "Resa") – Raski™</PageTitle>

@if (isLoading)
{
    <p class="muted">Hämtar resan…</p>
}
else if (errorMessage is not null)
{
    <div class="error-banner">@errorMessage</div>
}
else if (trip is not null)
{
    <div class="page-header">
        <div>
            <h1>@trip.Name</h1>
        </div>

        <div class="row-inline">
            <a class="btn btn-secondary" href="@($"resor/{TripId}/inkopslista")">Inköpslista</a>
            @if (IsAdmin)
            {
                <a class="btn btn-secondary" href="@($"resor/{TripId}/redigera")">Redigera</a>
            }
        </div>
    </div>

    <nav class="trip-tabs" role="tablist" aria-label="Resans flikar">
        <a class="trip-tab @(CurrentTab == Tab.Overview ? "active" : "")"
           role="tab"
           id="tab-overview"
           aria-selected="@(CurrentTab == Tab.Overview ? "true" : "false")"
           aria-controls="tabpanel"
           href="@($"resor/{TripId}/oversikt")">Översikt</a>
        <a class="trip-tab @(CurrentTab == Tab.Meals ? "active" : "")"
           role="tab"
           id="tab-meals"
           aria-selected="@(CurrentTab == Tab.Meals ? "true" : "false")"
           aria-controls="tabpanel"
           href="@($"resor/{TripId}/maltider")">Måltider</a>
        <a class="trip-tab @(CurrentTab == Tab.Bring ? "active" : "")"
           role="tab"
           id="tab-bring"
           aria-selected="@(CurrentTab == Tab.Bring ? "true" : "false")"
           aria-controls="tabpanel"
           href="@($"resor/{TripId}/vem-tar-med")">Vem tar med</a>
        <a class="trip-tab @(CurrentTab == Tab.Polls ? "active" : "")"
           role="tab"
           id="tab-polls"
           aria-selected="@(CurrentTab == Tab.Polls ? "true" : "false")"
           aria-controls="tabpanel"
           href="@($"resor/{TripId}/omrostningar")">Omröstningar</a>
    </nav>

    <div id="tabpanel" role="tabpanel" aria-labelledby="@TabId">
        @if (CurrentTab == Tab.Overview)
        {
            <section class="card overview">
                <h2>Översikt</h2>
                <div class="overview-grid">
                <div class="overview-details">
                @if (!string.IsNullOrWhiteSpace(trip.Destination) || trip.DestinationUrl is not null)
                {
                    <p>
                        📍 @trip.Destination
                        @if (trip.DestinationUrl is not null)
                        {
                            @if (!string.IsNullOrWhiteSpace(trip.Destination))
                            {
                                <text> – </text>
                            }
                            <a href="@trip.DestinationUrl" target="_blank" rel="noopener noreferrer">Visa på karta</a>
                        }
                    </p>
                }
                @if (trip.AccommodationUrl is not null)
                {
                    <p>🏠 Boende – <a href="@trip.AccommodationUrl" target="_blank" rel="noopener noreferrer">Visa boende</a></p>
                }
                @if (trip.AccommodationPhone is not null)
                {
                    <p>📞 Värd – <a href="tel:@trip.AccommodationPhone.Replace(" ", "")">@trip.AccommodationPhone</a></p>
                }
                <p>📅 @trip.StartDate.ToString("yyyy-MM-dd") – @trip.EndDate.ToString("yyyy-MM-dd")</p>
                @if (policies.Count > 0 || IsAdmin || CurrentUser?.IsGlobalAdmin == true)
                {
                    <p>
                        📜 <a href="@($"resor/{TripId}/policyer")">Policyer</a>
                        @if (UnacceptedPolicyCount > 0)
                        {
                            <text> – </text><strong>@UnacceptedPolicyCount att bekräfta</strong>
                        }
                    </p>
                }
                </div>
                @if (participantSummary is not null)
                {
                    <p class="overview-participants">👥 @participantSummary</p>
                }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(trip.Notes))
            {
                <section class="card notes">
                    <h2>Övrig info</h2>
                    <div id="notes-content" class="notes-content @(IsNotesLong && !notesExpanded ? "collapsed" : "")">
                        <FormattedText Text="@trip.Notes" />
                    </div>
                    @if (IsNotesLong)
                    {
                        <button type="button" class="btn btn-primary btn-sm notes-toggle" aria-expanded="@(notesExpanded ? "true" : "false")" aria-controls="notes-content"
                                @onclick="() => notesExpanded = !notesExpanded">
                            @(notesExpanded ? "Visa mindre" : "Visa mer")
                        </button>
                    }
                </section>
            }

            <MembersPanel TripId="@TripId"
                          StartDate="@trip.StartDate"
                          IsAdmin="@(IsAdmin || CurrentUser?.IsGlobalAdmin == true)"
                          ParticipantSummaryChanged="s => participantSummary = s" />
        }
        else if (CurrentTab == Tab.Bring)
        {
            <BringSections Trip="trip" />
        }
        else if (CurrentTab == Tab.Polls)
        {
            <PollsPanel Trip="trip" />
        }
        else
        {
            <BreakfastPanel Trip="trip" />

            <MealList Trip="trip" />
        }
    </div>
}

@code {
    [Parameter] public string TripId { get; set; } = "";

    [CascadingParameter(Name = "CurrentUser")]
    private UserProfile? CurrentUser { get; set; }

    private Trip? trip;
    private bool isLoading = true;
    private string? errorMessage;
    private string? participantSummary;
    private bool notesExpanded;

    private bool IsNotesLong =>
        trip?.Notes is { } notes && (notes.Length > 400 || notes.Split('\n').Length > 8);
    private List<TripPolicy> policies = [];

    private int UnacceptedPolicyCount => policies.Count(p => !p.IsAcceptedBy(CurrentUser?.Uid));

    private bool IsAdmin => trip?.IsOwner(CurrentUser?.Uid) == true;

    private enum Tab { Overview, Meals, Bring, Polls }

    private Tab CurrentTab
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            if (path.EndsWith("/vem-tar-med", StringComparison.OrdinalIgnoreCase)) return Tab.Bring;
            if (path.EndsWith("/omrostningar", StringComparison.OrdinalIgnoreCase)) return Tab.Polls;
            if (path.EndsWith("/maltider", StringComparison.OrdinalIgnoreCase)) return Tab.Meals;
            return Tab.Overview;
        }
    }

    private string TabId => CurrentTab switch
    {
        Tab.Bring => "tab-bring",
        Tab.Polls => "tab-polls",
        Tab.Meals => "tab-meals",
        _ => "tab-overview"
    };

    protected override async Task OnParametersSetAsync()
    {
        // Switching tabs re-renders the same page; only reload when the trip changes.
        if (trip is not null && trip.Id == TripId)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            trip = await TripService.GetAsync(TripId);

            if (trip is null)
            {
                errorMessage = "Resan hittades inte.";
            }
            else
            {
                await LoadPoliciesAsync();
            }
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte hämta resan.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPoliciesAsync()
    {
        try
        {
            policies = [.. await PolicyService.GetAsync(TripId)];
        }
        catch (Exception)
        {
            // Policies are secondary on the overview; the page still works without them.
            policies = [];
        }
    }
}
