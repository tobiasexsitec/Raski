@page "/"
@inject ITripService TripService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Mina resor – Raski™</PageTitle>

<div class="page-header">
    <h1>Mina resor</h1>
    @if (AuthService.IsGlobalAdmin)
    {
        <a class="btn btn-primary" href="resor/ny">Ny resa</a>
    }
</div>

@if (isLoading)
{
    <p class="muted">Hämtar resor…</p>
}
else if (errorMessage is not null)
{
    <div class="error-banner">@errorMessage</div>
}
else if (trips.Count == 0)
{
    <div class="empty-state card">
        <p><strong>Inga resor än.</strong></p>
        @if (AuthService.IsGlobalAdmin)
        {
            <p>Skapa din första resa så kan ni börja planera maten tillsammans.</p>
            <a class="btn btn-primary" href="resor/ny">Skapa resa</a>
        }
        else
        {
            <p>Be en global admin att skapa en resa och bjuda in dig.</p>
        }
    </div>
}
else
{
    @if (upcomingTrips.Count > 0)
    {
        @TripGrid(upcomingTrips)
    }
    else
    {
        <p class="muted">Inga kommande resor.</p>
    }

    @if (pastTrips.Count > 0)
    {
        <h2 class="section-heading">Tidigare resor</h2>
        @TripGrid(pastTrips)
    }
}

@code {
    private List<Trip> trips = [];
    private List<Trip> upcomingTrips = [];
    private List<Trip> pastTrips = [];
    private bool isLoading = true;
    private string? errorMessage;

    private RenderFragment<List<Trip>> TripGrid => items =>
    @<ul class="trip-grid">
        @foreach (var trip in items)
        {
            <li>
                <a class="card card-interactive trip" href="@($"resor/{trip.Id}")">
                    <h2>@trip.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(trip.Destination))
                    {
                        <p class="destination">📍 @trip.Destination</p>
                    }
                    <p class="muted dates">@FormatRange(trip)</p>
                    <span class="tag tag-accent">@trip.MemberUids.Count deltagare</span>
                </a>
            </li>
        }
    </ul>;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            trips = [.. await TripService.GetMyTripsAsync()];

            var today = DateOnly.FromDateTime(DateTime.Now);
            upcomingTrips = [.. trips.Where(t => t.EndDate >= today).OrderBy(t => t.StartDate)];
            pastTrips = [.. trips.Where(t => t.EndDate < today).OrderByDescending(t => t.StartDate)];
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunde inte hämta dina resor. {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatRange(Trip trip)
    {
        var nights = trip.EndDate.DayNumber - trip.StartDate.DayNumber;
        return $"{trip.StartDate:yyyy-MM-dd} – {trip.EndDate:yyyy-MM-dd} ({nights + 1} dagar)";
    }
}
