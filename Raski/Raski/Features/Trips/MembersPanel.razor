@inject ITripService TripService
@inject IUserService UserService
@inject IAuthService AuthService
@inject IHouseholdService HouseholdService

<section class="card">
    <h2>Deltagare</h2>

    @if (members.Count > 0)
    {
        <p class="muted" aria-live="polite">👥 @ParticipantSummary</p>
    }

    @if (members.Count == 0)
    {
        <p class="muted">Inga deltagare ännu.</p>
    }
    else
    {
        <ul class="member-list">
            @foreach (var group in groups)
            {
            <li class="@(group.Members.Count > 1 || group.Children.Count > 0 ? "member-group" : "member-group single")">
            <ul class="member-list">
            @foreach (var member in group.Members)
            {
                <li class="member">
                    @if (!string.IsNullOrEmpty(member.PhotoUrl))
                    {
                        <img class="avatar" src="@member.PhotoUrl" alt="" />
                    }
                    else
                    {
                        <span class="avatar avatar-fallback" aria-hidden="true">@Initial(member.DisplayName)</span>
                    }

                    <span class="member-info">
                        <strong>@member.DisplayName</strong>
                        <span class="muted">@member.Email</span>
                        @if (PhoneOf(member) is { Length: > 0 } phone)
                        {
                            <a class="muted" href="@($"tel:{phone}")">📞 @phone</a>
                        }
                        @if (member.Uid == AuthService.Current?.Uid)
                        {
                            <span class="row-inline" role="group" aria-label="Dricker du alkohol på den här resan?">
                                <span class="muted">🍷 Alkohol:</span>
                                @foreach (var option in AlcoholPreferenceExtensions.All)
                                {
                                    var selected = member.Alcohol == option;
                                    <button type="button"
                                            class="btn btn-sm @(selected ? "btn-primary" : "btn-secondary")"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            @onclick="() => SetAlcoholAsync(member, option)">
                                        @option.Label()
                                    </button>
                                }
                            </span>
                        }
                        else if (member.Alcohol is { } alcohol)
                        {
                            <span class="muted">🍷 @alcohol.Description()</span>
                        }
                        @if (AllergiesOf(member) is { Count: > 0 } memberAllergies)
                        {
                            <span class="allergy-tags" aria-label="Allergier och kostpreferenser för @member.DisplayName">
                                @foreach (var allergy in memberAllergies)
                                {
                                    <span class="tag">@allergy</span>
                                }
                            </span>
                        }
                    </span>

                    @if (member.IsPending)
                    {
                        <span class="tag">Inget konto än</span>
                    }

                    @if (member.IsAdmin)
                    {
                        <span class="tag tag-accent">Admin</span>
                    }
                    else if (IsAdmin)
                    {
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                @onclick="() => RemoveAsync(member)">
                            Ta bort
                        </button>
                    }
                </li>
            }
            @foreach (var child in group.Children)
            {
                var attending = !excludedChildIds.Contains(child.Id);
                <li class="member child @(attending ? "" : "absent")">
                    <span class="avatar avatar-fallback" aria-hidden="true">🧒</span>
                    <span class="member-info">
                        <strong>@child.Name</strong>
                        <span class="muted">@child.AgeOn(StartDate) år@(attending ? "" : " · följer inte med")</span>
                        @if (child.Allergies.Count > 0)
                        {
                            <span class="allergy-tags" aria-label="Allergier och kostpreferenser för @child.Name">
                                @foreach (var allergy in child.Allergies)
                                {
                                    <span class="tag">@allergy</span>
                                }
                            </span>
                        }
                    </span>
                    @if (IsAdmin || group.Members.Any(m => m.Uid == AuthService.Current?.Uid))
                    {
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                aria-pressed="@(attending ? "true" : "false")"
                                @onclick="() => SetChildAttendingAsync(child, !attending)">
                            @(attending ? "Välj bort" : "Ta med")
                        </button>
                    }
                </li>
            }
            </ul>
            </li>
            }
        </ul>

        <div class="allergy-summary">
            <h3>Allergier och kostpreferenser på resan</h3>
            @if (allAllergies.Count == 0)
            {
                <p class="muted">Inga registrerade allergier.</p>
            }
            else
            {
                <ul class="allergy-tags" aria-label="Alla allergier och kostpreferenser på resan">
                    @foreach (var allergy in allAllergies)
                    {
                        <li class="tag tag-accent">@allergy</li>
                    }
                </ul>
            }
        </div>
    }

    @if (IsAdmin)
    {
        <form class="invite-form" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <div class="field">
                <label>Bjud in användare eller e-post</label>
                <AutoComplete TItem="UserProfile"
                              @bind-Value="inviteEmail"
                              SearchFunc="SearchUsersAsync"
                              DisplaySelector="u => u.Email"
                              MinimumLength="3"
                              Placeholder="Namn eller kompis@example.com"
                              AriaLabel="Bjud in användare eller e-post">
                    <ItemTemplate Context="user">
                        <strong>@user.DisplayName</strong>
                        <span class="muted">@user.Email</span>
                    </ItemTemplate>
                </AutoComplete>
            </div>
            <div class="field">
                <label for="invite-name">Namn (valfritt)</label>
                <input id="invite-name" type="text" @bind="inviteName" placeholder="Används om personen saknar konto" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@isAdding">
                @(isAdding ? "Lägger till…" : "Lägg till")
            </button>
        </form>

        @if (statusMessage is not null)
        {
            <p class="status" role="status">@statusMessage</p>
        }

        @if (errorMessage is not null)
        {
            <div class="error-banner">@errorMessage</div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public string TripId { get; set; } = "";
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public DateOnly StartDate { get; set; }
    [Parameter] public EventCallback<string?> ParticipantSummaryChanged { get; set; }

    private string? loadedTripId;
    private string? reportedSummary;

    private sealed record MemberGroup(List<TripMember> Members, List<Child> Children);

    private List<MemberGroup> groups = [];
    private IReadOnlySet<string> excludedChildIds = new HashSet<string>();

    private List<TripMember> members = [];
    private Dictionary<string, List<string>> allergiesByUid = [];
    private Dictionary<string, string> phoneByUid = [];
    private List<string> allAllergies = [];
    private string inviteEmail = "";
    private string inviteName = "";
    private bool isAdding;
    private string? statusMessage;
    private string? errorMessage;

    private int AttendingChildCount =>
        groups.SelectMany(g => g.Children).Count(c => !excludedChildIds.Contains(c.Id));

    private string ParticipantSummary
    {
        get
        {
            var adults = members.Count;
            var children = AttendingChildCount;
            var total = adults + children;
            var totalText = total == 1 ? "1 person" : $"{total} personer";
            if (children == 0)
            {
                return totalText;
            }

            var adultText = adults == 1 ? "1 vuxen" : $"{adults} vuxna";
            return $"{totalText} ({adultText}, {children} barn)";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedTripId == TripId)
        {
            return;
        }

        loadedTripId = TripId;
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var summary = members.Count > 0 ? ParticipantSummary : null;
        if (summary != reportedSummary)
        {
            reportedSummary = summary;
            await ParticipantSummaryChanged.InvokeAsync(summary);
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            var loaded = await TripService.GetMembersAsync(TripId);
            members = [.. loaded.OrderByDescending(m => m.IsAdmin).ThenBy(m => m.DisplayName)];
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte hämta deltagarna.";
            return;
        }

        await LoadAllergiesAsync();
        await LoadHouseholdsAsync();
    }

    private async Task LoadHouseholdsAsync()
    {
        groups = [.. members.Select(m => new MemberGroup([m], []))];

        try
        {
            var uids = members.Where(m => !m.IsPending).Select(m => m.Uid).ToList();
            IReadOnlyList<Household> households = uids.Count == 0 ? [] : await HouseholdService.GetForMembersAsync(uids);
            excludedChildIds = await HouseholdService.GetExcludedChildIdsAsync(TripId);

            var householdByUid = uids.ToDictionary(
                uid => uid,
                uid => households.Where(h => h.MemberUids.Contains(uid)).ToList() is { Count: > 0 } mine
                    ? Raski.Services.HouseholdService.PickPrimary(mine)
                    : null);

            var seenChildIds = new HashSet<string>();
            var byHousehold = new Dictionary<string, MemberGroup>();
            groups = [];

            foreach (var member in members)
            {
                if (householdByUid.GetValueOrDefault(member.Uid) is not { } household)
                {
                    groups.Add(new MemberGroup([member], []));
                    continue;
                }

                if (byHousehold.TryGetValue(household.Id, out var existing))
                {
                    existing.Members.Add(member);
                    continue;
                }

                // Children keep their id when a household is split, so they are only listed once.
                var children = household.Children
                    .Where(c => seenChildIds.Add(c.Id))
                    .OrderBy(c => c.BirthDate)
                    .ToList();
                var group = new MemberGroup([member], children);
                byHousehold[household.Id] = group;
                groups.Add(group);
            }
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte hämta deltagarnas barn.";
        }

        UpdateAllAllergies();
    }

    private void UpdateAllAllergies()
    {
        allAllergies = [.. allergiesByUid.Values
            .SelectMany(a => a)
            .Concat(groups.SelectMany(g => g.Children)
                .Where(c => !excludedChildIds.Contains(c.Id))
                .SelectMany(c => c.Allergies))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a, StringComparer.CurrentCultureIgnoreCase)];
    }

    private async Task SetChildAttendingAsync(Child child, bool attending)
    {
        errorMessage = null;

        try
        {
            await HouseholdService.SetChildAttendingAsync(TripId, child.Id, attending);
            var updated = excludedChildIds.ToHashSet();

            if (attending)
            {
                updated.Remove(child.Id);
            }
            else
            {
                updated.Add(child.Id);
            }

            excludedChildIds = updated;
            UpdateAllAllergies();
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte spara om barnet följer med.";
        }
    }

    private async Task LoadAllergiesAsync()
    {
        try
        {
            var profiles = await Task.WhenAll(members.Where(m => !m.IsPending).Select(m => UserService.GetAsync(m.Uid)));

            allergiesByUid = profiles
                .Where(p => p is not null)
                .ToDictionary(
                    p => p!.Uid,
                    p => p!.Allergies
                        .Where(a => !string.IsNullOrWhiteSpace(a))
                        .Select(a => a.Trim())
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(a => a, StringComparer.CurrentCultureIgnoreCase)
                        .ToList());

            phoneByUid = profiles
                .Where(p => p is not null && !string.IsNullOrWhiteSpace(p.Phone))
                .ToDictionary(p => p!.Uid, p => p!.Phone.Trim());

            allAllergies = [.. allergiesByUid.Values
                .SelectMany(a => a)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(a => a, StringComparer.CurrentCultureIgnoreCase)];
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte hämta deltagarnas allergier.";
        }
    }

    private List<string>? AllergiesOf(TripMember member) =>
        allergiesByUid.GetValueOrDefault(member.Uid);

    private string? PhoneOf(TripMember member) =>
        phoneByUid.GetValueOrDefault(member.Uid);

    private IReadOnlyList<UserProfile>? allUsers;

    private async Task<IReadOnlyList<UserProfile>> SearchUsersAsync(string text)
    {
        var query = text.Trim();

        try
        {
            allUsers ??= await UserService.GetAllAsync();
        }
        catch (Exception)
        {
            return [];
        }

        var memberUids = members.Select(m => m.Uid).ToHashSet();
        var memberEmails = members.Select(m => m.Email).ToHashSet(StringComparer.OrdinalIgnoreCase);

        return [.. allUsers
            .Where(u => !string.IsNullOrWhiteSpace(u.Email))
            .Where(u => !memberUids.Contains(u.Uid) && !memberEmails.Contains(u.Email))
            .Where(u => u.DisplayName.Contains(query, StringComparison.CurrentCultureIgnoreCase)
                     || u.Email.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(8)];
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(inviteEmail))
        {
            return;
        }

        isAdding = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var added = await TripService.AddMemberAsync(TripId, inviteEmail, inviteName);

            statusMessage = added
                ? $"{inviteEmail} lades till i resan."
                : $"{inviteEmail} har inget konto än – lades till som deltagare och kopplas vid första inloggningen.";

            inviteEmail = "";
            inviteName = "";
            await ReloadAsync();
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte lägga till deltagaren.";
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task RemoveAsync(TripMember member)
    {
        errorMessage = null;

        try
        {
            await TripService.RemoveMemberAsync(TripId, member.Uid);
            members.Remove(member);
            allergiesByUid.Remove(member.Uid);
            phoneByUid.Remove(member.Uid);
            await LoadHouseholdsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte ta bort deltagaren.";
        }
    }

    private async Task SetAlcoholAsync(TripMember member, AlcoholPreference preference)
    {
        errorMessage = null;

        try
        {
            await TripService.SetMyAlcoholAsync(TripId, preference);
            member.Alcohol = preference;
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte spara alkoholvalet.";
        }
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
}
