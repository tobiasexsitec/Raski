@page "/resor/{TripId}/inkopslista"
@implements IAsyncDisposable
@inject IShoppingListService ShoppingListService
@inject ITripService TripService
@inject IIngredientService IngredientService

<PageTitle>Inköpslista – Raski™</PageTitle>

<Confetti @ref="confetti" />

<div class="page-header">
    <div>
        <h1>Inköpslista</h1>
        @if (trip is not null)
        {
            <p class="muted">@trip.Name</p>
        }
    </div>

    <a class="btn btn-secondary" href="@($"resor/{TripId}")">Till resan</a>
</div>

@if (isLoading)
{
    <p class="muted">Räknar ihop ingredienser…</p>
}
else if (errorMessage is not null && items.Count == 0)
{
    <div class="error-banner">@errorMessage</div>
}
else
{
    @if (errorMessage is not null)
    {
        <div class="error-banner">@errorMessage</div>
    }

    <h2>Lägg till på inköpslistan</h2>
    <p class="muted">Hör varan till en måltid? Registrera då ingrediensen under fliken "Måltider" på resan.</p>

    <form class="extra-form" @onsubmit="AddExtraAsync">
        <input class="field extra-name"
               placeholder="Vad behövs? T.ex. toapapper"
               aria-label="Vara"
               maxlength="100"
               @bind="newExtraName" />
        <input class="field extra-quantity"
               type="number"
               step="any"
               min="0"
               inputmode="decimal"
               placeholder="Mängd"
               aria-label="Mängd"
               @bind="newExtraAmount" />
        <div class="extra-unit">
            <AutoComplete TItem="string"
                          Value="@newExtraUnit"
                          ValueChanged="value => newExtraUnit = value"
                          SearchFunc="SearchUnitsAsync"
                          DisplaySelector="u => u"
                          MinimumLength="1"
                          AriaLabel="Enhet"
                          Placeholder="Enhet" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@isSaving">Lägg till</button>
    </form>

    @if (TotalCount > 0)
    {
        <p class="progress-text">@CheckedCount av @TotalCount ihandlade</p>
    }

    @if (groups.Count == 0)
    {
        <p class="muted">Inga ingredienser från måltider än.</p>
    }

    @foreach (var group in groups)
    {
        <section class="group">
            <h2>@group.DisplayTag</h2>

            <ul class="items">
                @foreach (var item in group.Items)
                {
                    <li class="item @(item.Checked ? "is-checked" : "")">
                        <label>
                            <input type="checkbox"
                                   checked="@item.Checked"
                                   @onchange="e => ToggleAsync(item, e)" />

                            <span class="item-body">
                                <span class="item-name">@item.Name</span>
                                <span class="item-amount">@FormatAmounts(item)</span>
                                @if (item.UsedInMeals.Count > 0)
                                {
                                    <span class="item-meals">@string.Join(", ", item.UsedInMeals)</span>
                                }
                            </span>
                        </label>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="group">
        <h2>Övrigt att handla</h2>

        @if (extras.Count > 0)
        {
            <ul class="items">
                @foreach (var item in extras)
                {
                    <li class="item extra-item @(item.Checked ? "is-checked" : "")">
                        <label>
                            <input type="checkbox"
                                   checked="@item.Checked"
                                   @onchange="e => ToggleAsync(item, e)" />

                            <span class="item-body">
                                <span class="item-name">@item.Name</span>
                                @if (item.Amounts.Count > 0)
                                {
                                    <span class="item-amount">@FormatAmounts(item)</span>
                                }
                            </span>
                        </label>

                        <button type="button"
                                class="btn btn-icon btn-sm"
                                aria-label="@($"Ta bort {item.Name}")"
                                disabled="@isSaving"
                                @onclick="() => DeleteExtraAsync(item)">✕</button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="muted">Inget övrigt tillagt än.</p>
        }
    </section>
}

@code {
    [Parameter] public string TripId { get; set; } = "";

    private Trip? trip;
    private IReadOnlyList<ShoppingListItem> items = [];
    private IReadOnlyList<ShoppingListGroup> groups = [];
    private IReadOnlyList<ShoppingListItem> extras = [];
    private string newExtraName = "";
    private decimal? newExtraAmount;
    private string newExtraUnit = "";
    private bool isSaving;
    private CancellationTokenSource? listenerCts;
    private bool isLoading = true;
    private string? errorMessage;
    private Confetti? confetti;
    private bool hasCelebrated;

    private int TotalCount => items.Count;
    private int CheckedCount => items.Count(i => i.Checked);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            trip = await TripService.GetAsync(TripId);
            items = await ShoppingListService.BuildAsync(TripId);
            Regroup();
            await StartListeningAsync();
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte hämta inköpslistan.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartListeningAsync()
    {
        await StopListeningAsync();

        listenerCts = new CancellationTokenSource();
        var token = listenerCts.Token;

        // Only the checked state is streamed; the aggregated rows change far less often.
        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var state in ShoppingListService.ObserveCheckedState(TripId, token))
                {
                    foreach (var item in items)
                    {
                        item.Checked = state.TryGetValue(item.IngredientId, out var value) && value;
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception)
            {
                errorMessage = "Realtidsuppdateringen bröts.";
                await InvokeAsync(StateHasChanged);
            }
        }, token);
    }

    private async Task ToggleAsync(ShoppingListItem item, ChangeEventArgs e)
    {
        var isChecked = e.Value is true;

        // Optimistic update; the listener confirms it for everyone else.
        item.Checked = isChecked;

        try
        {
            await ShoppingListService.SetCheckedAsync(TripId, item.IngredientId, isChecked);
            await CelebrateIfCompleteAsync();
        }
        catch (Exception)
        {
            item.Checked = !isChecked;
            errorMessage = "Kunde inte spara avbockningen.";
        }
    }

    private void Regroup()
    {
        groups = ShoppingListAggregator.GroupByTag(items.Where(i => !i.IsExtra));
        extras = [.. items.Where(i => i.IsExtra)];
    }

    private async Task AddExtraAsync()
    {
        if (string.IsNullOrWhiteSpace(newExtraName))
        {
            errorMessage = "Skriv vad som ska handlas.";
            return;
        }

        await SaveExtrasAsync(
            () => ShoppingListService.AddExtraAsync(TripId, newExtraName, newExtraAmount, newExtraUnit),
            "Kunde inte lägga till varan.");

        if (errorMessage is null)
        {
            newExtraName = "";
            newExtraAmount = null;
            newExtraUnit = "";
        }
    }

    private Task<IReadOnlyList<string>> SearchUnitsAsync(string term) =>
        IngredientService.SearchUnitsAsync(term);

    private Task DeleteExtraAsync(ShoppingListItem item) =>
        item.ExtraId is null
            ? Task.CompletedTask
            : SaveExtrasAsync(
                () => ShoppingListService.DeleteExtraAsync(TripId, item.ExtraId),
                "Kunde inte ta bort varan.");

    private async Task SaveExtrasAsync(Func<Task> save, string failureMessage)
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            await save();
            items = await ShoppingListService.BuildAsync(TripId);
            Regroup();
            hasCelebrated = TotalCount > 0 && CheckedCount == TotalCount;
        }
        catch (Exception)
        {
            errorMessage = failureMessage;
        }
        finally
        {
            isSaving = false;
        }
    }

    /// <summary>Celebrates once per completion so unchecking and rechecking can retrigger it.</summary>
    private async Task CelebrateIfCompleteAsync()
    {
        var isComplete = TotalCount > 0 && CheckedCount == TotalCount;

        if (!isComplete)
        {
            hasCelebrated = false;
            return;
        }

        if (hasCelebrated || confetti is null)
        {
            return;
        }

        hasCelebrated = true;
        await confetti.CelebrateAsync();
    }

    private static string FormatAmounts(ShoppingListItem item) =>
        string.Join(" + ", item.Amounts.Select(a =>
            string.IsNullOrWhiteSpace(a.Unit)
                ? Format(a.Amount)
                : $"{Format(a.Amount)} {a.Unit}"));

    private static string Format(decimal value) =>
        value == decimal.Truncate(value) ? ((long)value).ToString() : value.ToString("0.##");

    private async Task StopListeningAsync()
    {
        if (listenerCts is not null)
        {
            await listenerCts.CancelAsync();
            listenerCts.Dispose();
            listenerCts = null;
        }
    }

    public async ValueTask DisposeAsync() => await StopListeningAsync();
}
