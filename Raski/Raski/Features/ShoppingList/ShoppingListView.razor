@page "/resor/{TripId}/inkopslista"
@implements IAsyncDisposable
@inject IShoppingListService ShoppingListService
@inject ITripService TripService
@inject IIngredientService IngredientService
@inject IAuthService AuthService

<PageTitle>Inköpslista – Raski™</PageTitle>

<Confetti @ref="confetti" />

<div class="page-header">
    <div>
        <h1>Inköpslista</h1>
        @if (trip is not null)
        {
            <p class="muted">@trip.Name</p>
        }
    </div>

    <a class="btn btn-secondary" href="@($"resor/{TripId}")">Till resan</a>
</div>

@if (isLoading)
{
    <p class="muted">Räknar ihop ingredienser…</p>
}
else if (errorMessage is not null && items.Count == 0)
{
    <div class="error-banner">@errorMessage</div>
}
else
{
    @if (errorMessage is not null)
    {
        <div class="error-banner">@errorMessage</div>
    }

    @if (TotalCount > 0)
    {
        <p class="progress-text">@CheckedCount av @TotalCount ihandlade</p>
    }

    @if (TotalCount > 0)
    {
        <div class="filters" role="search">
            <input type="search"
                   class="field filter-search"
                   placeholder="Sök vara"
                   aria-label="Sök i inköpslistan"
                   @bind="searchText"
                   @bind:event="oninput" />

            <select class="field filter-tag" aria-label="Filtrera på tagg" @bind="selectedTag">
                <option value="">Alla taggar</option>
                @foreach (var tag in AvailableTags)
                {
                    <option value="@tag">@IngredientTags.Display(tag)</option>
                }
            </select>

            <button type="button"
                    class="btn btn-secondary btn-sm"
                    aria-expanded="@(showAdvanced ? "true" : "false")"
                    aria-controls="advanced-filters"
                    @onclick="() => showAdvanced = !showAdvanced">
                Avancerad filtrering@(AdvancedFilterCount > 0 ? $" ({AdvancedFilterCount})" : "")
            </button>

            @if (IsFiltering)
            {
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearFilters">Rensa</button>
            }

            @if (showAdvanced)
            {
                <div id="advanced-filters" class="advanced-filters">
                    <label class="field-label" for="filter-responsible">Ansvarig</label>
                    <select id="filter-responsible" class="field" @bind="selectedResponsible">
                        <option value="">Alla</option>
                        @foreach (var (key, name) in AvailableResponsibles)
                        {
                            <option value="@key">@name</option>
                        }
                    </select>

                    <label class="field-label" for="filter-meal">Maträtt</label>
                    <select id="filter-meal" class="field" @bind="selectedMeal">
                        <option value="">Alla</option>
                        @foreach (var (key, title) in AvailableMeals)
                        {
                            <option value="@key">@title</option>
                        }
                    </select>
                </div>
            }
        </div>
    }

    @if (groups.Count == 0)
    {
        <p class="muted">Inga ingredienser från måltider än.</p>
    }

    @if (IsFiltering && !items.Any(Matches))
    {
        <p class="muted">Inga varor matchar filtret.</p>
    }

    @foreach (var group in groups.Where(g => g.Tag != IngredientTags.Uncategorized))
    {
        var groupItems = group.Items.Where(Matches).ToList();
        if (groupItems.Count == 0)
        {
            continue;
        }

        <section class="group">
            <h2>@group.DisplayTag</h2>

            <ul class="items">
                @foreach (var item in groupItems)
                {
                    <li class="item @(item.Checked ? "is-checked" : "")">
                        <label>
                            <input type="checkbox"
                                   checked="@item.Checked"
                                   @onchange="e => ToggleAsync(item, e)" />

                            <span class="item-body">
                                <span class="item-name">@item.Name</span>
                                <span class="item-amount">@FormatAmounts(item)</span>
                                @if (item.UsedInMeals.Count > 0)
                                {
                                    <span class="item-meals">@string.Join(", ", item.UsedInMeals)</span>
                                }
                            </span>
                        </label>
                    </li>
                }
            </ul>
        </section>
    }

    @foreach (var category in new[] { ExtraCategories.Snacks, ExtraCategories.Other })
    {
        var meals = (category == ExtraCategories.Other ? uncategorized : []).Where(Matches).ToList();
        var categoryExtras = extras.Where(e => e.ExtraCategory == category).Where(Matches).ToList();

        if (IsFiltering && meals.Count == 0 && categoryExtras.Count == 0)
        {
            continue;
        }

    <section class="group">
        <h2>@ExtraCategories.Display(category)</h2>

        @if (meals.Count > 0 || categoryExtras.Count > 0)
        {
            <ul class="items">
                @foreach (var item in meals)
                {
                    <li class="item @(item.Checked ? "is-checked" : "")">
                        <label>
                            <input type="checkbox"
                                   checked="@item.Checked"
                                   @onchange="e => ToggleAsync(item, e)" />

                            <span class="item-body">
                                <span class="item-name">@item.Name</span>
                                <span class="item-amount">@FormatAmounts(item)</span>
                                @if (item.UsedInMeals.Count > 0)
                                {
                                    <span class="item-meals">@string.Join(", ", item.UsedInMeals)</span>
                                }
                            </span>
                        </label>
                    </li>
                }
                @foreach (var item in categoryExtras)
                {
                    <li class="item extra-item @(item.Checked ? "is-checked" : "")">
                        <label>
                            <input type="checkbox"
                                   checked="@item.Checked"
                                   @onchange="e => ToggleAsync(item, e)" />

                            <span class="item-body">
                                <span class="item-name">@item.Name</span>
                                @if (item.Amounts.Count > 0)
                                {
                                    <span class="item-amount">@FormatAmounts(item)</span>
                                }
                            </span>
                        </label>

                        <button type="button"
                                class="btn btn-icon btn-sm"
                                aria-label="@($"Ta bort {item.Name}")"
                                disabled="@isSaving"
                                @onclick="() => DeleteExtraAsync(item)">✕</button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="muted">Inget tillagt än.</p>
        }

        @if (!IsFiltering)
        {
            <ExtraItemForm Placeholder="@(category == ExtraCategories.Snacks ? "T.ex. kanelbullar eller chips" : "T.ex. diskmaskinstabletter")"
                           AriaLabel="@($"Vara till {ExtraCategories.Display(category)}")"
                           IsSaving="isSaving"
                           OnAdd="(name, amount, unit) => AddExtraAsync(category, name, amount, unit)" />
        }
    </section>
    }
}

@code {
    [Parameter] public string TripId { get; set; } = "";

    private Trip? trip;
    private IReadOnlyList<ShoppingListItem> items = [];
    private IReadOnlyList<ShoppingListGroup> groups = [];
    private IReadOnlyList<ShoppingListItem> extras = [];
    private IReadOnlyList<ShoppingListItem> uncategorized = [];
    private bool isSaving;
    private CancellationTokenSource? listenerCts;
    private bool isLoading = true;
    private string? errorMessage;
    private Confetti? confetti;
    private bool hasCelebrated;

    private string searchText = "";
    private string selectedTag = "";
    private string selectedResponsible = "";
    private string selectedMeal = "";
    private bool showAdvanced;

    private int TotalCount => items.Count;
    private int CheckedCount => items.Count(i => i.Checked);

    private bool IsAdvancedFiltering => selectedResponsible.Length > 0 || selectedMeal.Length > 0;

    private int AdvancedFilterCount =>
        (selectedResponsible.Length > 0 ? 1 : 0) + (selectedMeal.Length > 0 ? 1 : 0);

    private bool IsFiltering => !string.IsNullOrWhiteSpace(searchText) || selectedTag.Length > 0 || IsAdvancedFiltering;

    private static readonly string[] ExtraTitles =
        [ExtraCategories.Display(ExtraCategories.Snacks), ExtraCategories.Display(ExtraCategories.Other)];

    private IEnumerable<(string Key, string Name)> AvailableResponsibles
    {
        get
        {
            var currentUid = AuthService.Current?.Uid;

            return items
                .SelectMany(i => i.Sources)
                .Where(s => s.ResponsibleKey.Length > 0)
                .GroupBy(s => s.ResponsibleKey)
                .Select(g => (Key: g.Key, Name: g.Key == currentUid ? "Jag" : g.First().ResponsibleName.Trim()))
                .OrderBy(r => r.Key == currentUid ? 0 : 1)
                .ThenBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase);
        }
    }

    private IEnumerable<(string Key, string Title)> AvailableMeals =>
        items
            .SelectMany(i => i.Sources)
            .Where(s => !ExtraTitles.Contains(s.MealTitle) && !string.IsNullOrWhiteSpace(s.MealTitle))
            .GroupBy(s => s.MealKey)
            .Select(g => (Key: g.Key, Title: g.First().MealTitle))
            .OrderBy(m => m.Title, StringComparer.CurrentCultureIgnoreCase);

    private bool MatchesSource(ShoppingListSource source) =>
        (selectedResponsible.Length == 0 || source.ResponsibleKey == selectedResponsible)
        && (selectedMeal.Length == 0 || source.MealKey == selectedMeal);

    private IEnumerable<string> AvailableTags =>
        items.Select(i => i.PrimaryTag)
            .Concat(items.SelectMany(i => i.Tags))
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.CurrentCultureIgnoreCase);

    private bool Matches(ShoppingListItem item)
    {
        var query = searchText.Trim();
        if (query.Length > 0 && !item.Name.Contains(query, StringComparison.CurrentCultureIgnoreCase))
        {
            return false;
        }

        if (IsAdvancedFiltering && !item.Sources.Any(MatchesSource))
        {
            return false;
        }

        return selectedTag.Length == 0
            || string.Equals(item.PrimaryTag, selectedTag, StringComparison.OrdinalIgnoreCase)
            || item.Tags.Contains(selectedTag, StringComparer.OrdinalIgnoreCase);
    }

    private void ClearFilters()
    {
        searchText = "";
        selectedTag = "";
        selectedResponsible = "";
        selectedMeal = "";
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            trip = await TripService.GetAsync(TripId);
            items = await ShoppingListService.BuildAsync(TripId);
            Regroup();
            await StartListeningAsync();
        }
        catch (Exception)
        {
            errorMessage = "Kunde inte hämta inköpslistan.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartListeningAsync()
    {
        await StopListeningAsync();

        listenerCts = new CancellationTokenSource();
        var token = listenerCts.Token;

        // Only the checked state is streamed; the aggregated rows change far less often.
        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var state in ShoppingListService.ObserveCheckedState(TripId, token))
                {
                    foreach (var item in items)
                    {
                        item.Checked = state.TryGetValue(item.IngredientId, out var value) && value;
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception)
            {
                errorMessage = "Realtidsuppdateringen bröts.";
                await InvokeAsync(StateHasChanged);
            }
        }, token);
    }

    private async Task ToggleAsync(ShoppingListItem item, ChangeEventArgs e)
    {
        var isChecked = e.Value is true;

        // Optimistic update; the listener confirms it for everyone else.
        item.Checked = isChecked;

        try
        {
            await ShoppingListService.SetCheckedAsync(TripId, item.IngredientId, isChecked);
            await CelebrateIfCompleteAsync();
        }
        catch (Exception)
        {
            item.Checked = !isChecked;
            errorMessage = "Kunde inte spara avbockningen.";
        }
    }

    private void Regroup()
    {
        groups = ShoppingListAggregator.GroupByTag(items.Where(i => !i.IsExtra));
        extras = [.. items.Where(i => i.IsExtra)];
        uncategorized = [.. groups.Where(g => g.Tag == IngredientTags.Uncategorized).SelectMany(g => g.Items)];
    }

    private async Task<bool> AddExtraAsync(string category, string name, decimal? amount, string unit)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            errorMessage = "Skriv vad som ska handlas.";
            return false;
        }

        await SaveExtrasAsync(
            () => ShoppingListService.AddExtraAsync(TripId, name, amount, unit, category),
            "Kunde inte lägga till varan.");

        return errorMessage is null;
    }

    private Task DeleteExtraAsync(ShoppingListItem item) =>
        SaveExtrasAsync(
            async () =>
            {
                foreach (var extraId in item.ExtraIds)
                {
                    await ShoppingListService.DeleteExtraAsync(TripId, extraId);
                }
            },
            "Kunde inte ta bort varan.");

    private async Task SaveExtrasAsync(Func<Task> save, string failureMessage)
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            await save();
            items = await ShoppingListService.BuildAsync(TripId);
            Regroup();
            hasCelebrated = TotalCount > 0 && CheckedCount == TotalCount;
        }
        catch (Exception)
        {
            errorMessage = failureMessage;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    /// <summary>Celebrates once per completion so unchecking and rechecking can retrigger it.</summary>
    private async Task CelebrateIfCompleteAsync()
    {
        var isComplete = TotalCount > 0 && CheckedCount == TotalCount;

        if (!isComplete)
        {
            hasCelebrated = false;
            return;
        }

        if (hasCelebrated || confetti is null)
        {
            return;
        }

        hasCelebrated = true;
        await confetti.CelebrateAsync();
    }

    private string FormatAmounts(ShoppingListItem item)
    {
        if (!IsAdvancedFiltering)
        {
            return string.Join(" + ", item.Amounts.Select(a => FormatAmount(a.Amount, a.Unit)));
        }

        // Shown as "2 dl (av 5 dl)" so it is clear how much of the total the filter needs.
        var filtered = item.Sources
            .Where(MatchesSource)
            .GroupBy(s => s.Unit, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Sum(s => s.Amount), StringComparer.OrdinalIgnoreCase);

        return string.Join(" + ", item.Amounts
            .Where(a => filtered.GetValueOrDefault(a.Unit) > 0)
            .Select(a => $"{FormatAmount(filtered[a.Unit], a.Unit)} (av {FormatAmount(a.Amount, a.Unit)})"));
    }

    private string FormatAmount(decimal amount, string unit) =>
        string.IsNullOrWhiteSpace(unit)
            ? Format(amount)
            : $"{Format(amount)} {IngredientService.FormatUnit(unit, amount)}";

    private static string Format(decimal value) =>
        value == decimal.Truncate(value) ? ((long)value).ToString() : value.ToString("0.##");

    private async Task StopListeningAsync()
    {
        if (listenerCts is not null)
        {
            await listenerCts.CancelAsync();
            listenerCts.Dispose();
            listenerCts = null;
        }
    }

    public async ValueTask DisposeAsync() => await StopListeningAsync();
}
