@page "/login"
@layout EmptyLayout
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject FirebaseOptions FirebaseOptions

<PageTitle>Logga in – Raski™</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="brand" aria-hidden="true">🥕</div>
        <h1>Raski™</h1>
        <p class="tagline">Planera maten och inköpen för resan – tillsammans.</p>

        @if (!FirebaseOptions.IsConfigured)
        {
            <div class="error-banner">
                Firebase är inte konfigurerat. Fyll i <code>wwwroot/appsettings.json</code>.
            </div>
        }
        else
        {
            @if (errorMessage is not null)
            {
                <div class="error-banner">@errorMessage</div>
            }

            @if (FirebaseOptions.HasGoogleClientId)
            {
                <div class="google-gis-btn" @ref="googleButton"></div>
            }
            else
            {
            <button class="btn btn-primary google-btn" @onclick="SignInAsync" disabled="@isSigningIn">
                @if (isSigningIn)
                {
                    <span>Loggar in…</span>
                }
                else
                {
                    <span class="google-mark" aria-hidden="true">G</span>
                    <span>Fortsätt med Google</span>
                }
            </button>
            }
        }

        <a class="btn btn-primary about-link" href="about">Om Raski™</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool isSigningIn;
    private string? errorMessage;
    private ElementReference googleButton;
    private DotNetObjectReference<Login>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !FirebaseOptions.IsConfigured || !FirebaseOptions.HasGoogleClientId || AuthService.Current is not null)
        {
            return;
        }

        selfRef = DotNetObjectReference.Create(this);

        try
        {
            await AuthService.RenderGoogleButtonAsync(googleButton, selfRef);
        }
        catch (JSException)
        {
            errorMessage = "Kunde inte ladda Google-inloggningen. Ladda om sidan och försök igen.";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnGoogleSignInFailed(string code)
    {
        errorMessage = "Inloggningen misslyckades. Försök igen.";
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        AuthService.StateChanged += OnStateChanged;
    }

    protected override void OnParametersSet()
    {
        RedirectIfSignedIn();
    }

    private void OnStateChanged()
    {
        isSigningIn = false;
        RedirectIfSignedIn();
        StateHasChanged();
    }

    private void RedirectIfSignedIn()
    {
        if (AuthService.Current is null)
        {
            return;
        }

        var target = string.IsNullOrWhiteSpace(ReturnUrl) || ReturnUrl.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            ? ""
            : ReturnUrl;

        Navigation.NavigateTo(target, replace: true);
    }

    private async Task SignInAsync()
    {
        isSigningIn = true;
        errorMessage = null;

        try
        {
            await AuthService.SignInWithGoogleAsync();
        }
        catch (Exception)
        {
            errorMessage = "Inloggningen misslyckades. Försök igen.";
            isSigningIn = false;
        }
    }

    public void Dispose()
    {
        AuthService.StateChanged -= OnStateChanged;
        selfRef?.Dispose();
    }
}
